# Clé API Anthropic (Claude), nécessaire pour la reformulation.
# Obtenir une clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modèle utilisé (optionnel, défaut: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase (authentification + persistance de l'historique).
# Valeurs disponibles dans le dashboard Supabase > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
