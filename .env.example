# Clé API Anthropic (Claude), nécessaire pour la reformulation.
# Obtenir une clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modèle utilisé (optionnel, défaut: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase (persistance de l'historique). Sans ces variables, l'historique
# fonctionne quand même mais n'est pas conservé entre les redéploiements.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Code d'accès à 6 chiffres pour déverrouiller l'app (optionnel,
# défaut: 160374). Sera géré via une page administrateur plus tard.
ACCESS_CODE=160374

# Secret utilisé pour signer le cookie de session (optionnel mais
# recommandé en production — change-le sur une valeur aléatoire).
SESSION_SECRET=
