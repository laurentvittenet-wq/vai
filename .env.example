# Clé API Anthropic (Claude), nécessaire pour la reformulation.
# Obtenir une clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modèle utilisé (optionnel, défaut: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase (persistance de l'historique). Sans ces variables, l'historique
# fonctionne quand même mais n'est pas conservé entre les redéploiements.
SUPABASE_URL=
SUPABASE_ANON_KEY=
