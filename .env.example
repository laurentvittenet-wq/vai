# Clé API Anthropic (Claude), nécessaire pour la reformulation.
# Obtenir une clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modèle utilisé (optionnel, défaut: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase côté serveur (persistance de l'historique et du mur de la paix).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase côté client (authentification par email). Doit pointer vers le
# même projet Supabase que Chaudron/MAgicDraw pour la connexion unique (SSO).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
